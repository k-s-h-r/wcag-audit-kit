      "text": "Interaction motion example\nThe moving square is decorative. The button also increments a text count.\nMove illustration\nCount: 0\n\n\nconst variant=new URLSearchParams(location.search).get('variant')||'good';\nif(!['good','bad'].includes(variant))throw new Error('Unknown variant');\ndocument.documentElement.dataset.variant=variant;\nlet count=0;\ndocument.querySelector('#run').addEventListener('click',()=>{\n document.querySelector('#count').textContent=String(++count);\n const track=document.querySelector('#track');track.classList.remove('running');void track.offsetWidth;track.classList.add('running');\n});",
