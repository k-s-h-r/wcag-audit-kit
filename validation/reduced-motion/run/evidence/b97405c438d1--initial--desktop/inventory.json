      "tag": "html",
      "id": "",
      "role": null,
      "text": "Interaction motion example\n\nbody{font:20px/1.6 sans-serif;margin:2rem;color:#111;background:white}\nbutton{font:inherit;padding:.6rem;border:2px solid #444;background:#eee;color:#111}\n:focus-visible{outline:3px solid #005bba;outline-offset:4px}\n#track{width:250px;height:90px;border:1px solid #555;margin:1rem 0}\n#box{width:60px;height:60px;background:#005bba;margin:10px}\n.running #box{animation:travel 1000ms linear forwards}\n@keyframes travel{from{transform:translateX(0)}to{transform:translateX(120px)}}\n@media(prefers-reduced-motion:reduce){html[data-variant=good] .running #box{animation:none}}\nInteraction motion example\nThe moving square is decorative. The button also increments a text count.\nMove illustration\nCount: 0\n\n\nconst variant=new URLSearchParams(location.search).get('variant')||'go",
