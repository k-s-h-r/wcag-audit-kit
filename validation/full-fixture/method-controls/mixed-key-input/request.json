{
  "case_id": "34a7f96c807b--initial--desktop--1.3.2",
  "url": "http://127.0.0.1:4317/reader-controls-good.html",
  "settle_ms": 1600,
  "locale": "en-US",
  "observe": [
    {
      "selector": "#visual-state"
    },
    {
      "selector": "#email-switch",
      "attributes": [
        "role",
        "aria-checked"
      ]
    }
  ],
  "actions": [
    {
      "type": "reader.press",
      "keys": [
        "Control_L",
        "Home"
      ],
      "expect_contains": "Notification settings"
    },
    {
      "type": "reader.press",
      "keys": [
        "Down"
      ],
      "expect_contains": "Use the checkbox"
    },
    {
      "type": "reader.press",
      "keys": [
        "Down"
      ]
    },
    {
      "type": "reader.press",
      "keys": [
        "Down"
      ]
    },
    {
      "type": "browser.press",
      "key": "Tab",
      "expect_contains": "Email notifications"
    },
    {
      "type": "browser.press",
      "key": "Space",
      "expect_contains": "checked",
      "expect_not_contains": [
        "not checked",
        "unchecked"
      ]
    },
    {
      "type": "browser.press",
      "key": "Space",
      "expect_contains": "not checked"
    },
    {
      "type": "browser.press",
      "key": "Tab"
    },
    {
      "type": "browser.press",
      "key": "Shift+Tab",
      "expect_contains": "Email notifications"
    }
  ]
}
