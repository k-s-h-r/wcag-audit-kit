{
  "case_id": "e743f12ce843--initial--desktop--1.3.4",
  "url": "http://127.0.0.1:4320/",
  "viewport": {
    "width": 390,
    "height": 844
  },
  "orientation": "portrait-primary",
  "assert": [
    {
      "selector": "#email-switch[aria-checked=\"false\"]",
      "visible": true
    },
    {
      "selector": "#visual-state",
      "text": "Off"
    }
  ],
