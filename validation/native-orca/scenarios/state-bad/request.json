{
  "case_id": "native-orca-state-bad",
  "url": "http://127.0.0.1:4317/reader-controls-bad.html",
  "locale": "en-US",
  "settle_ms": 1800,
  "observe": [
    {
      "selector": "#visual-state"
    },
    {
      "selector": "#email-switch",
      "attributes": [
        "role",
        "aria-checked"
      ]
    }
  ],
  "actions": [
    {
      "type": "browser.press",
      "key": "Tab",
      "expect_contains": "Email notifications"
    },
    {
      "type": "browser.press",
      "key": "Space",
      "expect_contains": "checked",
      "expect_not_contains": [
        "not checked",
        "unchecked"
      ]
    },
    {
      "type": "browser.press",
      "key": "Space",
      "expect_contains": "not checked"
    }
  ]
}
