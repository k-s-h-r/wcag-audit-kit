{
  "case_id": "aa61afa5bf07--initial--desktop--3.3.1",
  "url": "http://127.0.0.1:4330/profile",
  "observe": [
    {
      "selector": "#errors"
    },
    {
      "selector": "#name",
      "attributes": [
        "aria-invalid"
      ]
    },
    {
      "selector": "#email",
      "attributes": [
        "aria-invalid"
      ]
    }
  ],
  "actions": [
    {
      "type": "reader.press",
      "keys": [
        "Control_L",
        "Home"
      ]
    },
    {
      "type": "reader.nextHeading",
      "expect_contains": "Edit your profile"
    },
    {
      "type": "browser.fill",
