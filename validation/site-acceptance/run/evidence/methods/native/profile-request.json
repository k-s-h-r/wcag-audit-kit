      "value": ""
    },
    {
      "type": "browser.fill",
      "selector": "#email",
      "value": "not-an-email"
    },
    {
      "type": "reader.press",
      "keys": [
        "Tab"
      ],
      "expect_contains": "Review changes"
    },
    {
      "type": "reader.press",
      "keys": [
        "space"
      ],
      "expect_contains": "Correct the following"
    },
    {
      "type": "reader.press",
      "keys": [
        "Down"
      ]
    },
    {
      "type": "reader.press",
      "keys": [
        "Down"
      ]
    }
  ],
  "auth_state": "/tmp/wcag-acceptance-bootstrap-002/storage-state.json",
  "locale": "en-US",
  "settle_ms": 1400
}
