    {
      "id": "c04",
      "pages": [
        "p04.html"
      ],
      "checkpoints": [
        "2.1.1-02"
      ],
      "states": [
        {
          "id": "keyboard-route",
          "instructions": [
            "初期状態からTabで「製品」へ移動してEnter、Tabで「業務支援」へ移動してEnter、Tabで第3階層の「見積管理」へ移動する。ポインターで補わずに実行する。 最後にEnterでリンク先へ移動し、URLと見積管理の見出しを確認する。"
          ],
          "residual_probe": {
            "target": "#navigation",
            "keyboard": [
              {
                "selector": "#level1",
                "keys": [
                  "Enter",
                  "Space"
                ],
                "reach": "tab"
              },
              {
                "selector": "#level2",
                "keys": [
                  "Enter",
                  "Space"
                ],
                "reach": "tab"
              },
              {
                "selector": "#leaf",
                "keys": [
                  "Enter"
                ],
                "reach": "tab"
              }
            ],
            "pointer": [
              "#level1",
              "#level2",
              "#leaf"
            ],
            "result": {
              "kind": "navigate",
              "resource": "destination.html",
              "heading": "見積管理"
            }
          }
        }
      ],
      "oracle_scope": "exhaustive-for-listed-checkpoints",
      "expectations": [
        {
          "page": "p04.html",
          "state": "keyboard-route",
          "target": "#navigation",
          "checkpoint": "2.1.1-02",
          "expected": "passed",
          "rationale": "2回の展開と第3階層リンクの実行をキーだけで行い、見積管理のページへ移動できる。",
          "modes": {
            "machine": "evaluate",
            "ai": "evaluate",
            "screen-reader": "evaluate",
            "full": "evaluate"
          },
          "evidence_kind": "program"
        }
      ],
      "target_aliases": {
        "2.1.1-02": {
          "#level1": "#navigation",
          "#level2": "#navigation",
          "#leaf": "#navigation",
          "#other-leaf": "#navigation",
          "#close": "#navigation"
        }
      }
