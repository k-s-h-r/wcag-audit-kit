          "rationale": "保存結果が表示だけ変わり状態通知としてマークされていない。",
          "modes": {
            "machine": "defer",
            "ai": "defer",
            "screen-reader": "evaluate",
            "full": "evaluate"
          },
          "evidence_kind": "screen-reader"
        }
      ],
      "evidence_expectations": [
        {
          "checkpoint": "4.1.3-01",
          "kind": "state-capture",
          "targets": [
            "#subject"
          ],
          "captures": [
            "待機中",
            "保存しました"
          ],
          "role_attribute": null,
          "page": "p03.html",
          "state": "after-save",
          "rationale": "保存結果が表示だけ変わり状態通知としてマークされていない。"
        }
      ],
      "fixture_probe": {
        "steps": [
          {
            "action": "click",
            "selector": "#save"
          },
          {
            "action": "wait",
            "selector": "#subject",
            "text": "保存しました"
          }
        ]
      },
      "requires_environment": [
        "real-screen-reader"
      ]
    },
